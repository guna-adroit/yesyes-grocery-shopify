      "max": 4,
      "step": 0.5,
      "default": 3
    }, {
      "type": "range",
      "id": "gap_desktop",
      "label": "Gap on desktop",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    }, {
      "type": "range",
      "id": "gap_mobile",
      "label": "Gap on mobile",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 10
    }, {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        {
          "value": "page-width",
          "label": "Page"
        }, {
          "value": "full-width",
          "label": "Full"
        }
      ],
      "default": "page-width"
    }, {
