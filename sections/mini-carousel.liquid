{%- liquid
  assign slide_count = section.blocks.size
  assign per_view_desktop = section.settings.slides_per_view_desktop
  assign per_view_mobile = section.settings.slides_per_view_mobile

  # Slide widths are built here rather than in the stylesheet: Shopify's CSS minifier
  # strips the space in "100% - (", which makes the calc() invalid.
  assign gaps_desktop = per_view_desktop | minus: 1 | times: section.settings.gap_desktop
  assign gaps_mobile = per_view_mobile | minus: 1 | times: section.settings.gap_mobile
  assign slide_width_desktop = 'calc((100% - ' | append: gaps_desktop | append: 'px) / ' | append: per_view_desktop | append: ')'
  assign slide_width_mobile = 'calc((100% - ' | append: gaps_mobile | append: 'px) / ' | append: per_view_mobile | append: ')'

  assign aspect_ratio = section.settings.aspect_ratio
  if aspect_ratio == 'adapt'
    assign aspect_ratio = 1
    for block in section.blocks
      if block.settings.image != blank
        assign aspect_ratio = block.settings.image.aspect_ratio
        break
      endif
    endfor
  endif

  assign autoplay_speed = 0
  if section.settings.autoplay
    assign autoplay_speed = section.settings.autoplay_speed
  endif

  assign sizes = '(min-width: 750px) calc(100vw / ' | append: per_view_desktop | append: '), calc(100vw / ' | append: per_view_mobile | append: ')'
  assign widths = '165, 240, 330, 400, 500, 660, 800'
  assign dot_label = 'accessibility.slide_status' | t: index: '[index]', length: '[length]'
-%}

<script src="{{ 'mini-carousel.js' | asset_url }}" defer="defer"></script>

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div class="spacing-style section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}" style="{% render 'spacing-padding', settings: section.settings %}">
  <mini-carousel
    class="mini-carousel mini-carousel--nav-{{ section.settings.navigation_position }}"
    style="
      --mc-slide-width-desktop: {{ slide_width_desktop }};
      --mc-slide-width-mobile: {{ slide_width_mobile }};
      --mc-gap-desktop: {{ section.settings.gap_desktop }}px;
      --mc-gap-mobile: {{ section.settings.gap_mobile }}px;
      --mc-radius: {{ section.settings.corner_radius }}px;
      --mc-aspect-ratio: {{ aspect_ratio }};
    "
    {% if autoplay_speed > 0 %}
    autoplay="{{ autoplay_speed }}"
    {% endif %}
    {% if section.settings.loop %}
    loop
    {% endif %}
    {% if section.settings.pause_on_hover %}
    pause-on-hover
    {% endif %}
    data-dot-label="{{ dot_label | escape }}"
    role="region"
    aria-roledescription="carousel"
    aria-label="{{ section.settings.accessibility_label | default: 'Promotions' | escape }}">
    <div class="mini-carousel__viewport">
      <ul
        class="mini-carousel__track list-unstyled"
        data-track
        tabindex="-1">
        {%- for block in section.blocks -%}
          {%- liquid
            assign image = block.settings.image
            assign alt = block.settings.alt_text | default: image.alt
            assign slide_label = 'accessibility.slide_status' | t: index: forloop.index, length: slide_count
            assign loading = 'lazy'
            if section.index <= 2 and forloop.index <= per_view_desktop
              assign loading = 'eager'
            endif
          -%}
          {%- capture slide_media -%}
            {%- if image != blank -%}
              {{
                image
                | image_url: width: 800
                | image_tag: widths: widths, sizes: sizes, alt: alt, loading: loading, class: 'mini-carousel__image'
              }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'mini-carousel__image mini-carousel__placeholder' }}
            {%- endif -%}
          {%- endcapture -%}
          <li
            class="mini-carousel__slide"
            aria-roledescription="slide"
            aria-label="{{ slide_label }}"
            {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a
                class="mini-carousel__media"
                href="{{ block.settings.link }}"
                {% if block.settings.open_in_new_tab %}
                target="_blank"
                rel="noopener"
                {% endif %}
                {% if alt == blank %}
                aria-label="{{ slide_label }}"
                {% endif %}>
                {{- slide_media -}}
              </a>
            {%- else -%}
              <div class="mini-carousel__media">{{ slide_media }}</div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>

      {%- if section.settings.show_navigation and section.settings.navigation_position == 'sides' -%}
        <button
          type="button"
          class="mini-carousel__arrow mini-carousel__arrow--side mini-carousel__arrow--prev"
          data-prev
          aria-label="{{ 'accessibility.slideshow_previous' | t }}">
          {{- 'icon-chevron-left.svg' | inline_asset_content -}}
        </button>
        <button
          type="button"
          class="mini-carousel__arrow mini-carousel__arrow--side mini-carousel__arrow--next"
          data-next
          aria-label="{{ 'accessibility.slideshow_next' | t }}">
          {{- 'icon-chevron-right.svg' | inline_asset_content -}}
        </button>
      {%- endif -%}
    </div>

    {%- if section.settings.show_pagination or section.settings.show_navigation and section.settings.navigation_position == 'below' -%}
      <div class="mini-carousel__controls" data-controls>
        {%- if section.settings.show_navigation and section.settings.navigation_position == 'below' -%}
          <button
            type="button"
            class="mini-carousel__arrow mini-carousel__arrow--prev"
            data-prev
            aria-label="{{ 'accessibility.slideshow_previous' | t }}">
            {{- 'icon-chevron-left.svg' | inline_asset_content -}}
          </button>
        {%- endif -%}

        {%- if section.settings.show_pagination -%}
          <div class="mini-carousel__dots" data-dots></div>
        {%- endif -%}

        {%- if section.settings.show_navigation and section.settings.navigation_position == 'below' -%}
          <button
            type="button"
            class="mini-carousel__arrow mini-carousel__arrow--next"
            data-next
            aria-label="{{ 'accessibility.slideshow_next' | t }}">
            {{- 'icon-chevron-right.svg' | inline_asset_content -}}
          </button>
        {%- endif -%}
      </div>
    {%- endif -%}
  </mini-carousel>
</div>

{% stylesheet %}
  .mini-carousel {
    --mc-slide-width: var(--mc-slide-width-mobile);
    --mc-gap: var(--mc-gap-mobile);

    display: block;
    position: relative;
    min-width: 0;
  }

  @media screen and (min-width: 750px) {
    .mini-carousel {
      --mc-slide-width: var(--mc-slide-width-desktop);
      --mc-gap: var(--mc-gap-desktop);
    }
  }

  .mini-carousel__viewport {
    position: relative;
  }

  .mini-carousel__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: var(--mc-slide-width);
    gap: var(--mc-gap);
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .mini-carousel__track::-webkit-scrollbar {
    display: none;
  }

  .mini-carousel__track:focus-visible {
    outline: none;
  }

  .mini-carousel__slide {
    scroll-snap-align: start;
    min-width: 0;
  }

  .mini-carousel__media {
    display: block;
    overflow: hidden;
    border-radius: var(--mc-radius);
    aspect-ratio: var(--mc-aspect-ratio);
  }

  .mini-carousel__media:focus-visible {
    outline: var(--focus-outline-width, 2px) solid currentColor;
    outline-offset: 2px;
  }

  .mini-carousel__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .mini-carousel__placeholder {
    background-color: color-mix(in srgb, var(--color-foreground) 6%, transparent);
  }

  @media (hover: hover) {
    a.mini-carousel__media:hover .mini-carousel__image {
      transform: scale(1.03);
    }
  }

  .mini-carousel__controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    margin-top: 24px;
  }

  .mini-carousel[data-single] .mini-carousel__controls,
  .mini-carousel[data-single] .mini-carousel__arrow--side {
    display: none;
  }

  .mini-carousel__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-foreground);
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .mini-carousel__arrow svg {
    width: 10px;
    height: 16px;
    --icon-stroke-width: 2;
  }

  .mini-carousel__arrow:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .mini-carousel__arrow--side {
    position: absolute;
    top: 50%;
    z-index: 1;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: var(--color-background);
    box-shadow: 0 2px 8px rgb(0 0 0 / 0.15);
    transform: translateY(-50%);
  }

  .mini-carousel__arrow--side.mini-carousel__arrow--prev {
    inset-inline-start: 8px;
  }

  .mini-carousel__arrow--side.mini-carousel__arrow--next {
    inset-inline-end: 8px;
  }

  .mini-carousel__arrow--side:disabled {
    opacity: 0;
    pointer-events: none;
  }

  [dir='rtl'] .mini-carousel__arrow svg {
    transform: scaleX(-1);
  }

  .mini-carousel__dots {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .mini-carousel__dot {
    width: 10px;
    height: 10px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background-color: color-mix(in srgb, var(--color-foreground) 20%, transparent);
    cursor: pointer;
    transition: width 0.3s ease
    , background-color 0.3s ease;
  }

  .mini-carousel__dot[aria-current='true'] {
    width: 38px;
    background-color: var(--color-foreground);
  }

  @media (prefers-reduced-motion: reduce) {
    .mini-carousel__image,
    .mini-carousel__dot {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
  {
    "name": "Mini carousel",
    "blocks": [
      {
        "type": "slide",
        "name": "Slide",
        "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "Slide image",
            "info": "Use the same aspect ratio for every slide. Square (1:1) recommended, e.g. 600 x 600px."
          }, {
            "type": "url",
            "id": "link",
            "label": "Slide link"
          }, {
            "type": "checkbox",
            "id": "open_in_new_tab",
            "label": "Open link in new tab",
            "default": false
          }, {
            "type": "text",
            "id": "alt_text",
            "label": "Image alt text",
            "info": "Describes the image for screen readers. Falls back to the image's own alt text."
          }
        ]
      }
    ],
    "disabled_on": {
      "groups": ["header", "footer"]
    },
    "settings": [
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "range",
        "id": "slides_per_view_desktop",
        "label": "Slides per view on desktop",
        "min": 2,
        "max": 10,
        "step": 1,
        "default": 7
      },
      {
        "type": "range",
        "id": "slides_per_view_mobile",
        "label": "Slides per view on mobile",
        "info": "Use a half value (e.g. 2.5) to show part of the next slide.",
        "min": 1,
        "max": 4,
        "step": 0.5,
        "default": 2.5
      },
      {
        "type": "select",
        "id": "aspect_ratio",
        "label": "Image aspect ratio",
        "options": [
          {
            "value": "1",
            "label": "Square (1:1)"
          }, {
            "value": "0.8",
            "label": "Portrait (4:5)"
          }, {
            "value": "1.333",
            "label": "Landscape (4:3)"
          }, {
            "value": "adapt",
            "label": "Adapt to first image"
          }
        ],
        "default": "1"
      }, {
        "type": "range",
        "id": "gap_desktop",
        "label": "Gap between slides on desktop",
        "min": 0,
        "max": 48,
        "step": 2,
        "unit": "px",
        "default": 24
      }, {
        "type": "range",
        "id": "gap_mobile",
        "label": "Gap between slides on mobile",
        "min": 0,
        "max": 32,
        "step": 2,
        "unit": "px",
        "default": 12
      }, {
        "type": "range",
        "id": "corner_radius",
        "label": "Corner radius",
        "min": 0,
        "max": 40,
        "step": 1,
        "unit": "px",
        "default": 12
      }, {
        "type": "select",
        "id": "section_width",
        "label": "Width",
        "options": [
          {
            "value": "page-width",
            "label": "Page"
          }, {
            "value": "full-width",
            "label": "Full"
          }
        ],
        "default": "page-width"
      }, {
        "type": "header",
        "content": "Autoplay"
      }, {
        "type": "checkbox",
        "id": "autoplay",
        "label": "Auto-rotate slides",
        "default": false
      }, {
        "type": "range",
        "id": "autoplay_speed",
        "label": "Rotation time",
        "min": 2,
        "max": 10,
        "step": 1,
        "unit": "s",
        "default": 5,
        "visible_if": "{{ section.settings.autoplay }}"
      }, {
        "type": "checkbox",
        "id": "pause_on_hover",
        "label": "Pause on hover",
        "default": true,
        "visible_if": "{{ section.settings.autoplay }}"
      }, {
        "type": "checkbox",
        "id": "loop",
        "label": "Loop back to the start",
        "info": "When off, arrows stop at the first and last slides. Auto-rotation always loops.",
        "default": true
      }, {
        "type": "header",
        "content": "Pagination and navigation"
      }, {
        "type": "checkbox",
        "id": "show_pagination",
        "label": "Show pagination dots",
        "default": true
      }, {
        "type": "checkbox",
        "id": "show_navigation",
        "label": "Show navigation arrows",
        "default": true
      }, {
        "type": "select",
        "id": "navigation_position",
        "label": "Arrow position",
        "options": [
          {
            "value": "below",
            "label": "Below, beside the dots"
          }, {
            "value": "sides",
            "label": "On the sides of the slides"
          }
        ],
        "default": "below",
        "visible_if": "{{ section.settings.show_navigation }}"
      }, {
        "type": "header",
        "content": "Appearance"
      }, {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "scheme-1"
      }, {
        "type": "text",
        "id": "accessibility_label",
        "label": "Carousel name for screen readers",
        "default": "Promotions"
      }, {
        "type": "header",
        "content": "Padding"
      }, {
        "type": "range",
        "id": "padding-block-start",
        "label": "Top",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 24
      }, {
        "type": "range",
        "id": "padding-block-end",
        "label": "Bottom",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 24
      }
    ],
    "presets": [
      {
        "name": "Mini carousel",
        "blocks": [
          {
            "type": "slide"
          },
          {
            "type": "slide"
          },
          {
            "type": "slide"
          },
          {
            "type": "slide"
          }, {
            "type": "slide"
          }, {
            "type": "slide"
          }, {
            "type": "slide"
          }, {
            "type": "slide"
          }
        ]
      }
    ]
  }
{% endschema %}